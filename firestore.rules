rules_version = '2';
// Bullet POS 2.5.1 — Reglas de seguridad de Firestore.
// 2.5.1: turnos aprobados por el PC Main (shiftApproval: el secundario solo pide el turno).
// 2.5.0: el proveedor puede autorizar el primer equipo de un negocio nuevo (vendorBootstrap).
// 2.4.0: inventario y costos (invItems, invRecipes, invMovements).
// 2.3.0: solicitudes de cobro (chargeRequests) y permiso «Cobro directo».
// 2.2.0: personal con PIN (staff).
// 2.1.0: generación de datos (control/generation) para el reinicio real y
// entregas a caja (cashReceipts). Ver la sección «generación de datos».
// Todos los datos viven en cafeterias/{cafeId}/... y solo los dispositivos
// autorizados de ESE negocio (devices/{uid}.active == true) pueden usarlos.
// PC Main: UID incluido en control/admin.mainDeviceIds (máximo 2), o
// control/admin.mainDeviceId en configuraciones anteriores.
//
// 2.0.0 agrega (todo lo de 1.8.0 se conserva):
// - Equipo revocado con plazo (devices/{uid}.drainUntil): ya no opera, pero
//   puede terminar de enviar sus ventas, auditoría, turnos y estado.
// - Dispositivo perdido (lost == true): sin plazo; solo puede confirmar el
//   bloqueo y el borrado (lockSeenAt, wipedAt).
// - Vinculación de instalación (installId) que el propio equipo escribe una vez.
// - Turnos (shifts), historial de reinicios (historyResets).
// - Licencia (licenses/{cafeId}): solo la escribe la cuenta del proveedor.
//   Si existe, autorizar dispositivos y abrir turnos exige que esté vigente.
//   Sin documento de licencia se mantiene el comportamiento de 1.9.0.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function devicePath(cafeId) {
      return /databases/$(database)/documents/cafeterias/$(cafeId)/devices/$(request.auth.uid);
    }
    function adminPath(cafeId) {
      return /databases/$(database)/documents/cafeterias/$(cafeId)/control/admin;
    }
    function pairingPath(cafeId) {
      return /databases/$(database)/documents/cafeterias/$(cafeId)/control/mainPairing;
    }
    function tablePath(cafeId, id) {
      return /databases/$(database)/documents/cafeterias/$(cafeId)/mesas/$(id);
    }
    function salePath(cafeId, id) {
      return /databases/$(database)/documents/cafeterias/$(cafeId)/sales/$(id);
    }
    function approvedDevice(cafeId) {
      return signedIn()
        && exists(devicePath(cafeId))
        && get(devicePath(cafeId)).data.active == true;
    }
    function mainListOf(a) {
      return a.get('mainDeviceIds', [a.get('mainDeviceId', '')]);
    }
    function isMain(cafeId) {
      return approvedDevice(cafeId)
        && exists(adminPath(cafeId))
        && request.auth.uid in mainListOf(get(adminPath(cafeId)).data);
    }
    // Compatibilidad: mientras no exista un PC Main configurado, los
    // dispositivos autorizados conservan los permisos que tenían antes.
    function isMainOrBootstrap(cafeId) {
      return isMain(cafeId) || (approvedDevice(cafeId) && !exists(adminPath(cafeId)));
    }

    // --- 2.0.0: equipo revocado que aún puede enviar lo que ya registró ---
    function drainingDevice(cafeId) {
      return signedIn()
        && exists(devicePath(cafeId))
        && get(devicePath(cafeId)).data.get('active', false) == false
        && get(devicePath(cafeId)).data.get('lost', false) != true
        && get(devicePath(cafeId)).data.get('drainUntil', null) is timestamp
        && get(devicePath(cafeId)).data.drainUntil > request.time;
    }
    function canSend(cafeId) {
      return approvedDevice(cafeId) || drainingDevice(cafeId);
    }
    // --- 2.3.0: «Cobro directo» por equipo (lo cambia solo un PC Main) ---
    // Sin el permiso, un secundario no registra ventas, abonos ni libera
    // mesas por cobro: envía solicitudes de cobro. Al quitar el permiso hay
    // 24 h (directChargeGrace) para enviar lo que ya cobró. Un equipo sin el
    // campo (antes de la migración que hace el PC Main 2.3.0) conserva el
    // comportamiento anterior.
    function canDirectCharge(cafeId) {
      return isMainOrBootstrap(cafeId)
        || get(devicePath(cafeId)).data.get('directCharge', true) == true
        || (get(devicePath(cafeId)).data.get('directChargeGrace', null) is timestamp
            && get(devicePath(cafeId)).data.directChargeGrace > request.time);
    }

    // --- 2.0.0: licencia del proveedor ---
    // Cuenta del proveedor: inicio de sesión con Google y correo verificado.
    function isVendor() {
      return signedIn()
        && request.auth.token.get('email', '') == 'thebulletes@gmail.com'
        && request.auth.token.get('email_verified', false) == true;
    }
    function licensePath(cafeId) {
      return /databases/$(database)/documents/licenses/$(cafeId);
    }
    function licenseValid(l) {
      return l.get('status', 'active') == 'active'
        && l.get('expiresAtTs', null) is timestamp
        && l.expiresAtTs + duration.value(l.get('graceDays', 7), 'd') > request.time;
    }
    // Sin documento de licencia: modo compatibilidad (igual que 1.9.0).
    function licenseOk(cafeId) {
      return !exists(licensePath(cafeId)) || licenseValid(get(licensePath(cafeId)).data);
    }

    // --- 2.1.0: generación de datos (reinicio real) ---
    // control/generation.gen sube en cada reinicio. Los datos de operación
    // llevan su campo "gen": no se puede crear nada de una generación vieja
    // (un equipo antiguo no revive lo borrado) y el PC Main solo puede borrar
    // documentos de generaciones anteriores. Sin documento: generación 0.
    function genPath(cafeId) {
      return /databases/$(database)/documents/cafeterias/$(cafeId)/control/generation;
    }
    function curGen(cafeId) {
      return exists(genPath(cafeId)) ? get(genPath(cafeId)).data.get('gen', 0) : 0;
    }
    function genOk(cafeId, d) {
      return d.get('gen', 0) == curGen(cafeId);
    }
    function oldGen(cafeId, d) {
      return d.get('gen', 0) < curGen(cafeId);
    }

    // --- Sumas de pagos (máximo 8 pagos por venta) ---
    function amt(p, i) {
      return p.size() > i ? p[i].amount : 0;
    }
    function paySum(p) {
      return amt(p, 0) + amt(p, 1) + amt(p, 2) + amt(p, 3)
        + amt(p, 4) + amt(p, 5) + amt(p, 6) + amt(p, 7);
    }

    // --- Dispositivos ---
    // 2.5.0: negocio nuevo sin PC Main: el proveedor (emisor de licencias) puede
    // ver los equipos y autorizar el primero. En cuanto existe control/admin
    // (hay PC Main), solo el PC Main los administra.
    function vendorBootstrap(cafeId) {
      return isVendor() && !exists(adminPath(cafeId));
    }
    match /cafeterias/{cafeId}/devices/{deviceId} {
      allow get: if signedIn() && (request.auth.uid == deviceId || isMainOrBootstrap(cafeId) || vendorBootstrap(cafeId));
      allow list: if isMainOrBootstrap(cafeId) || vendorBootstrap(cafeId);
      // Un equipo nuevo solo puede pedir acceso (siempre inactivo).
      // 2.0.0: crear un equipo ya activo exige una licencia vigente (o ninguna).
      allow create: if (isMainOrBootstrap(cafeId)
            && (request.resource.data.get('active', false) != true || licenseOk(cafeId)))
        || (signedIn() && request.auth.uid == deviceId
            && request.resource.data.active == false
            && request.resource.data.keys().hasOnly(['active', 'requestedAt', 'ua']));
      // Autorizar, revocar y nombrar: PC Main. Un equipo solo puede marcarse
      // como "main" en la misma operación en que una vinculación válida lo
      // agregó a la lista de Main (ver control/mainPairing).
      // 2.0.0: activar un equipo inactivo exige una licencia vigente (o ninguna).
      allow update: if (isMainOrBootstrap(cafeId)
            && (request.resource.data.get('active', false) != true
                || resource.data.get('active', false) == true
                || licenseOk(cafeId)))
        || (signedIn() && request.auth.uid == deviceId
            && resource.data.active == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'mainSince'])
            && request.resource.data.role == 'main'
            && request.auth.uid in getAfter(adminPath(cafeId)).data.get('mainDeviceIds', []))
        // 2.0.0: el equipo registra su instalación una sola vez (el PC Main
        // puede borrarla con «Reconocer instalación»).
        || (signedIn() && request.auth.uid == deviceId
            && resource.data.get('installId', null) == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['installId', 'installBoundAt']))
        // 2.0.0: un equipo revocado o perdido solo confirma el bloqueo/borrado.
        || (signedIn() && request.auth.uid == deviceId
            && resource.data.get('active', false) == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lockSeenAt', 'wipedAt']))
        // 2.5.0: el proveedor autoriza el primer equipo de un negocio nuevo.
        || (vendorBootstrap(cafeId)
            && licenseOk(cafeId)
            && request.resource.data.active == true
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['active', 'name', 'role', 'approvedAt', 'approvedBy']));
      allow delete: if isMainOrBootstrap(cafeId);
    }

    // --- Catálogo: todos lo leen, solo el PC Main lo modifica ---
    match /cafeterias/{cafeId}/products/{productId} {
      allow read: if approvedDevice(cafeId);
      allow write: if isMainOrBootstrap(cafeId);
    }

    // --- 2.4.0: inventario y costos ---
    // Elementos (materia prima, insumos, preparaciones, reventa) y recetas:
    // todos los equipos autorizados los leen (un equipo con «Cobro directo»
    // guarda en su venta el consumo y el costo); solo un PC Main los modifica.
    match /cafeterias/{cafeId}/invItems/{itemId} {
      allow read: if approvedDevice(cafeId);
      allow create, update: if isMainOrBootstrap(cafeId)
        && request.resource.data.name is string
        && request.resource.data.kind in ['raw', 'supply', 'prep', 'resale']
        && request.resource.data.baseUnit in ['g', 'ml', 'u'];
      allow delete: if false;
    }
    // Recetas versionadas: una versión nunca se elimina.
    match /cafeterias/{cafeId}/invRecipes/{recipeId} {
      allow read: if approvedDevice(cafeId);
      allow create: if isMainOrBootstrap(cafeId) && request.resource.data.versions is list;
      allow update: if isMainOrBootstrap(cafeId)
        && request.resource.data.versions is list
        && request.resource.data.versions.size() >= resource.data.versions.size();
      allow delete: if false;
    }
    // Compras, mermas, ajustes, conteos y lotes de producción: solo un PC Main
    // los crea, de la generación vigente; no se modifican (solo el reintento
    // idéntico) y solo el reinicio global borra los de generaciones anteriores.
    // El consumo por venta no es un movimiento: viaja dentro de la venta
    // (sales/{id}.inv), así que solo existe junto con una venta válida.
    match /cafeterias/{cafeId}/invMovements/{moveId} {
      allow read: if isMainOrBootstrap(cafeId);
      allow create: if isMainOrBootstrap(cafeId)
        && genOk(cafeId, request.resource.data)
        && request.resource.data.id == moveId
        && request.resource.data.itemId is string
        && request.resource.data.qty is number
        && request.resource.data.type in ['purchase', 'waste', 'adjust', 'count', 'produceIn', 'produceOut'];
      allow update: if isMainOrBootstrap(cafeId) && request.resource.data == resource.data;
      allow delete: if isMainOrBootstrap(cafeId) && oldGen(cafeId, resource.data);
    }

    // --- Ventas ---
    match /cafeterias/{cafeId}/sales/{saleId} {
      // 1.8.0: el PC Main lee el historial global; un dispositivo secundario
      // solo sus propias ventas (las consultas deben filtrar por deviceId).
      allow read: if isMainOrBootstrap(cafeId)
        || (approvedDevice(cafeId) && resource.data.deviceId == request.auth.uid);
      // Cada dispositivo registra sus propias ventas, nunca anuladas. Si la
      // venta cobra una mesa, su ID es el paymentOperationId (idempotencia) y
      // la suma de los pagos debe cubrir el total.
      // 2.0.0: un equipo revocado con plazo puede terminar de enviar sus ventas.
      // 2.1.0: toda venta nueva debe ser de la generación vigente.
      // 2.3.0: un secundario solo crea ventas si tiene «Cobro directo».
      allow create: if genOk(cafeId, request.resource.data) && (isMainOrBootstrap(cafeId)
        || (canSend(cafeId)
            && canDirectCharge(cafeId)
            && request.resource.data.deviceId == request.auth.uid
            && request.resource.data.total is number
            && request.resource.data.items is list
            && request.resource.data.get('voided', false) == false
            && (request.resource.data.get('table', null) == null
                || (request.resource.data.get('paymentOperationId', '') == saleId
                    && request.resource.data.get('payments', []).size() <= 8
                    && paySum(request.resource.data.get('payments', [])) >= request.resource.data.total))));
      // Anular, corregir el pago o archivar: solo el PC Main. El dueño de la
      // venta solo puede reenviarla sin cambios (reintento idempotente).
      allow update: if isMainOrBootstrap(cafeId)
        || (canSend(cafeId)
            && resource.data.deviceId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().size() == 0);
      // Las ventas de la generación vigente nunca se eliminan (se anulan o
      // archivan). 2.1.0: el reinicio real borra las de generaciones anteriores.
      allow delete: if isMain(cafeId) && oldGen(cafeId, resource.data);
    }

    // --- Mesas: máquina de estados del cobro ---
    // Toda escritura incrementa "rev" en 1 (evita sobrescrituras en silencio
    // entre dispositivos). Un dispositivo que no es Main:
    //   - puede abrir mesas libres y corregir productos ANTES de iniciar el cobro,
    //     sin dejar vacía una mesa que ya tuvo consumo;
    //   - una vez iniciado el cobro no puede cambiar productos ni subtotal;
    //   - solo libera la mesa con una venta del servidor que cubra la cuenta,
    //     moviéndola a otra mesa en la misma operación, o si nunca tuvo consumo.
    function hadItemsOf(d) {
      return d.get('hadItems', false) == true || d.get('items', []).size() > 0;
    }
    function lockedOf(d) {
      return d.get('checkout', null) != null;
    }
    function sameItems(a, b) {
      return a.get('items', []) == b.get('items', []);
    }
    function waiterOpenEdit(b, a) {
      return a.get('open', false) == true
        && a.get('partials', []).hasAll(b.get('partials', []))
        && (
          // abrir una mesa libre
          (b.get('open', false) == false
            && a.get('checkout', null) == null
            && a.get('partials', []).size() == 0)
          // corregir antes de iniciar el cobro
          || (b.get('open', false) == true && !lockedOf(b)
            && a.get('checkout', null) == null
            && a.get('partials', []).size() == b.get('partials', []).size()
            && (!hadItemsOf(b)
                || (a.get('items', []).size() > 0 && a.get('hadItems', false) == true)))
          // iniciar el cobro: la cuenta queda congelada
          || (b.get('open', false) == true && !lockedOf(b)
            && a.get('checkout', null) != null
            && a.checkout.state == 'iniciado'
            && a.checkout.opId is string
            && a.checkout.subtotal is number
            && sameItems(a, b)
            && a.get('items', []).size() > 0
            && a.get('partials', []).size() == b.get('partials', []).size())
          // cobro en curso: estado, propina y abonos; nunca productos
          || (b.get('open', false) == true && lockedOf(b)
            && a.get('checkout', null) != null
            && a.checkout.opId == b.checkout.opId
            && a.checkout.subtotal == b.checkout.subtotal
            && a.checkout.state in ['iniciado', 'pendiente', 'fallido']
            && sameItems(a, b)
            && a.get('partials', []).size() <= 6)
          // cancelar el cobro sin abonos: la mesa sigue ocupada e intacta
          || (b.get('open', false) == true && lockedOf(b)
            && a.get('checkout', null) == null
            && sameItems(a, b)
            && b.get('partials', []).size() == 0
            && a.get('partials', []).size() == 0)
        );
    }
    function saleCovers(cafeId, b) {
      let s = get(salePath(cafeId, b.checkout.opId)).data;
      return s.get('table', -1) == b.n
        && s.get('voided', false) == false
        && s.get('paymentOperationId', '') == b.checkout.opId
        && s.subtotal == b.checkout.subtotal
        && s.get('payments', []).size() <= 8
        && paySum(s.get('payments', [])) >= s.total;
    }
    function movedOk(cafeId, b, a) {
      let d = getAfter(tablePath(cafeId, 'mesa-' + string(a.movedTo))).data;
      return d.get('open', false) == true
        && d.get('items', []) == b.get('items', [])
        && d.get('movedFrom', null) == b.n
        && d.get('checkout', null) == null;
    }
    function waiterRelease(cafeId, b, a) {
      return b.get('open', false) == true
        && a.get('open', false) == false
        && a.get('items', []).size() == 0
        && a.get('checkout', null) == null
        && a.get('partials', []).size() == 0
        && (
          // cobro válido ya registrado en el servidor
          // (2.3.0: solo con «Cobro directo»; si no, la libera el PC Main)
          (lockedOf(b)
            && canDirectCharge(cafeId)
            && a.get('releasedBySale', '') == b.checkout.opId
            && saleCovers(cafeId, b))
          // mesa abierta por error que nunca tuvo consumo
          || (!lockedOf(b) && !hadItemsOf(b) && b.get('partials', []).size() == 0)
          // la cuenta pasa completa a otra mesa en la misma operación
          || (!lockedOf(b)
            && b.get('partials', []).size() == 0
            && a.get('movedTo', null) is int
            && movedOk(cafeId, b, a))
        );
    }
    match /cafeterias/{cafeId}/mesas/{mesaId} {
      allow read: if approvedDevice(cafeId);
      allow create: if approvedDevice(cafeId)
        && request.resource.data.rev == 1
        && mesaId == 'mesa-' + string(request.resource.data.n);
      allow update: if approvedDevice(cafeId)
        && request.resource.data.rev == resource.data.get('rev', 0) + 1
        && request.resource.data.get('n', -1) == resource.data.get('n', request.resource.data.get('n', -1))
        // 2.3.0: agregar abonos (dinero recibido) exige «Cobro directo».
        && (isMain(cafeId)
            || request.resource.data.get('partials', []).size() <= resource.data.get('partials', []).size()
            || canDirectCharge(cafeId))
        && (isMain(cafeId)
            || waiterOpenEdit(resource.data, request.resource.data)
            || waiterRelease(cafeId, resource.data, request.resource.data)
            // mesa libre que sigue libre y sin productos
            || (resource.data.get('open', false) == false
                && request.resource.data.get('open', false) == false
                && request.resource.data.get('items', []).size() == 0
                && request.resource.data.get('checkout', null) == null));
      allow delete: if isMain(cafeId);
    }

    // --- Control: admin, vinculación del segundo Main, caja y negocio ---
    function adminListOk() {
      let l = mainListOf(request.resource.data);
      return l.size() >= 1 && l.size() <= 2
        && request.auth.uid in l
        && request.resource.data.get('mainDeviceId', '') in l;
    }
    // Un dispositivo autorizado se agrega como segundo Main solo con el código
    // vigente de un solo uso generado por un PC Main (en la misma operación).
    function claimSecondMain(cafeId) {
      let p = get(pairingPath(cafeId)).data;
      let pa = getAfter(pairingPath(cafeId)).data;
      return p.used == false
        && p.expiresAt > request.time
        && pa.used == true
        && pa.usedBy == request.auth.uid
        && pa.claimCode == p.code
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mainDeviceIds', 'updatedAt'])
        && request.resource.data.mainDeviceIds == mainListOf(resource.data).concat([request.auth.uid])
        && request.resource.data.mainDeviceIds.size() <= 2;
    }
    function claimPairing(cafeId) {
      return resource.data.used == false
        && resource.data.expiresAt > request.time
        && request.resource.data.claimCode == resource.data.code
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.used == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy', 'usedAt', 'claimCode'])
        && request.auth.uid in getAfter(adminPath(cafeId)).data.get('mainDeviceIds', []);
    }
    match /cafeterias/{cafeId}/control/{docId} {
      allow get: if approvedDevice(cafeId)
        && ((docId == 'admin'
              && (resource == null || request.auth.uid in mainListOf(resource.data)))
            || (docId == 'mainPairing' && isMain(cafeId))
            || (docId != 'admin' && docId != 'mainPairing'));
      allow list: if false;
      // Configurar el primer PC Main: solo si aún no existe y para sí mismo.
      allow create: if approvedDevice(cafeId)
        && ((docId == 'admin'
             && !exists(adminPath(cafeId))
             && request.resource.data.mainDeviceId == request.auth.uid
             && mainListOf(request.resource.data) == [request.auth.uid])
            || (docId != 'admin' && isMain(cafeId)));
      allow update: if approvedDevice(cafeId)
        && ((isMain(cafeId) && (docId != 'admin' || adminListOk()))
            || (docId == 'admin' && !isMain(cafeId) && claimSecondMain(cafeId))
            || (docId == 'mainPairing' && !isMain(cafeId) && claimPairing(cafeId)));
      allow delete: if false;
    }

    // --- Caja compartida: todos la leen, solo un PC Main la administra ---
    // 2.1.0: cajas y movimientos llevan la generación; los de generaciones
    // anteriores no se crean ni modifican, y solo el reinicio los borra.
    match /cafeterias/{cafeId}/cashSessions/{sessionId} {
      allow read: if approvedDevice(cafeId);
      allow create: if isMain(cafeId) && genOk(cafeId, request.resource.data);
      allow update: if isMain(cafeId) && genOk(cafeId, resource.data) && genOk(cafeId, request.resource.data);
      allow delete: if isMain(cafeId) && oldGen(cafeId, resource.data);
    }
    match /cafeterias/{cafeId}/cashMovements/{moveId} {
      allow read: if approvedDevice(cafeId);
      allow create: if isMain(cafeId) && genOk(cafeId, request.resource.data);
      allow update: if isMain(cafeId) && genOk(cafeId, resource.data) && genOk(cafeId, request.resource.data);
      allow delete: if isMain(cafeId) && oldGen(cafeId, resource.data);
    }
    // 2.1.0: entrega a caja de un cobro de mesero (una por venta). Solo un PC
    // Main la confirma; no cambia después. El mesero ve las de sus cobros.
    match /cafeterias/{cafeId}/cashReceipts/{saleId} {
      allow read: if isMainOrBootstrap(cafeId)
        || (canSend(cafeId) && resource.data.collectedBy == request.auth.uid);
      allow create: if isMainOrBootstrap(cafeId)
        && request.resource.data.saleId == saleId
        && genOk(cafeId, request.resource.data);
      allow update: if isMainOrBootstrap(cafeId) && request.resource.data == resource.data;
      allow delete: if isMain(cafeId) && oldGen(cafeId, resource.data);
    }

    // --- Reporte de estado de cada dispositivo (supervisión de los Main) ---
    match /cafeterias/{cafeId}/deviceStatus/{deviceId} {
      allow read: if isMainOrBootstrap(cafeId);
      allow create, update: if canSend(cafeId)
        && request.auth.uid == deviceId
        && request.resource.data.deviceId == request.auth.uid;
      allow delete: if isMainOrBootstrap(cafeId);
    }

    // --- Auditoría: solo se agregan registros; cualquier Main la consulta ---
    match /cafeterias/{cafeId}/audit/{entryId} {
      allow read: if isMain(cafeId);
      allow create: if canSend(cafeId)
        && request.resource.data.by == request.auth.uid;
      // Reintento idempotente: reescribir exactamente el mismo contenido.
      allow update: if canSend(cafeId)
        && request.resource.data == resource.data;
      allow delete: if false;
    }

    // --- 2.0.0: turnos de los dispositivos secundarios ---
    // Cada equipo abre y cierra sus propios turnos (la cola puede enviar el
    // turno ya cerrado si se abrió y cerró sin conexión). Un turno cerrado no
    // cambia, salvo la confirmación de entrega que registra un PC Main.
    // 2.5.1: con control/policy.shiftApproval == true, un secundario no abre su
    // turno: lo pide (status "requested") y solo un PC Main lo abre ("open") o
    // lo rechaza ("rejected"). El secundario puede cancelar su solicitud.
    function shiftApprovalRequired(cafeId) {
      let p = /databases/$(database)/documents/cafeterias/$(cafeId)/control/policy;
      return exists(p) && get(p).data.get('shiftApproval', false) == true;
    }
    match /cafeterias/{cafeId}/shifts/{shiftId} {
      allow get: if isMainOrBootstrap(cafeId)
        || (canSend(cafeId) && (resource == null || resource.data.deviceId == request.auth.uid));
      allow list: if isMainOrBootstrap(cafeId);
      allow create: if genOk(cafeId, request.resource.data)
        && ((isMainOrBootstrap(cafeId) && request.resource.data.id == shiftId)
          || (approvedDevice(cafeId) && licenseOk(cafeId)
            && request.resource.data.deviceId == request.auth.uid
            && request.resource.data.id == shiftId
            && (request.resource.data.status == 'requested'
                || (request.resource.data.status in ['open', 'closed'] && !shiftApprovalRequired(cafeId)))));
      allow update: if (isMainOrBootstrap(cafeId)
            && request.resource.data.id == shiftId
            && (resource.data.status in ['open', 'requested']
                || request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(['reviewedAt', 'reviewedBy', 'reviewedByName', 'reviewNote'])))
        || (canSend(cafeId)
            && resource.data.deviceId == request.auth.uid
            && request.resource.data.deviceId == request.auth.uid
            && request.resource.data.id == shiftId
            && (resource.data.status == 'open'
                || request.resource.data == resource.data
                || (resource.data.status == 'requested'
                    && request.resource.data.status == 'cancelled'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt']))));
      // 2.1.0: solo el reinicio real borra turnos de generaciones anteriores.
      allow delete: if isMain(cafeId) && oldGen(cafeId, resource.data);
    }

    // --- 2.3.0: solicitudes de cobro ---
    // El mesero crea la solicitud (pendiente) y solo puede cancelarla mientras
    // siga pendiente. Aceptarla o rechazarla: solo un PC Main.
    match /cafeterias/{cafeId}/chargeRequests/{reqId} {
      allow read: if isMainOrBootstrap(cafeId)
        || (canSend(cafeId) && resource.data.deviceId == request.auth.uid);
      allow create: if genOk(cafeId, request.resource.data)
        && request.resource.data.id == reqId
        && (isMainOrBootstrap(cafeId)
          || (approvedDevice(cafeId)
            && request.resource.data.deviceId == request.auth.uid
            && request.resource.data.status in ['pending', 'cancelled']));
      allow update: if (isMainOrBootstrap(cafeId) && request.resource.data.id == reqId)
        || (canSend(cafeId)
            && resource.data.deviceId == request.auth.uid
            && (request.resource.data == resource.data
                || (resource.data.status == 'pending'
                    && request.resource.data.status == 'cancelled'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'cancelledAt']))));
      allow delete: if isMain(cafeId) && oldGen(cafeId, resource.data);
    }

    // --- 2.2.0: personal con PIN (el PIN se guarda cifrado) ---
    // Todos los equipos autorizados lo leen (desbloquean sin internet). Un
    // equipo secundario solo puede registrar a su propio mesero al configurarse;
    // crear administradores, restablecer PIN o desactivar: solo un PC Main.
    match /cafeterias/{cafeId}/staff/{staffId} {
      allow read: if approvedDevice(cafeId);
      allow create: if request.resource.data.id == staffId
        && request.resource.data.pinHash is string
        && (isMainOrBootstrap(cafeId)
          || (approvedDevice(cafeId)
            && request.resource.data.role == 'waiter'
            && request.resource.data.get('active', true) == true
            && request.resource.data.createdByDevice == request.auth.uid));
      allow update: if (isMainOrBootstrap(cafeId) && request.resource.data.id == staffId)
        || (approvedDevice(cafeId) && request.resource.data == resource.data);
      allow delete: if false;
    }

    // --- 2.0.0: historial de reinicios globales (la época vigente está en
    // control/historyEpoch, que ya cubren las reglas de control) ---
    match /cafeterias/{cafeId}/historyResets/{resetId} {
      allow read: if isMain(cafeId);
      allow create: if isMain(cafeId) && request.resource.data.id == resetId;
      allow update, delete: if false;
    }

    // --- 2.0.0: licencia del negocio (solo la escribe el proveedor) ---
    match /licenses/{cafeId} {
      allow read: if approvedDevice(cafeId) || isVendor();
      allow create, update: if isVendor()
        && request.resource.data.cafeId == cafeId
        && request.resource.data.expiresAtTs is timestamp
        && request.resource.data.graceDays is int
        && request.resource.data.status in ['active', 'suspended'];
      allow delete: if isVendor();
    }

    // Todo lo demás queda denegado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
