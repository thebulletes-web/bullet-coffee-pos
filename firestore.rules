rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function approvedDevice(cafeId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/cafeterias/$(cafeId)/devices/$(request.auth.uid))
        && get(/databases/$(database)/documents/cafeterias/$(cafeId)/devices/$(request.auth.uid)).data.active == true;
    }

    match /cafeterias/{cafeId}/devices/{deviceId} {
      allow get: if request.auth != null && request.auth.uid == deviceId;
      allow list: if approvedDevice(cafeId);
      // Un equipo nuevo puede pedir acceso (siempre inactivo); un equipo
      // aprobado puede registrar/autorizar otros.
      allow create: if approvedDevice(cafeId)
        || (request.auth != null && request.auth.uid == deviceId
            && request.resource.data.active == false
            && request.resource.data.keys().hasOnly(['active','requestedAt','ua']));
      allow update, delete: if approvedDevice(cafeId);
    }

    match /cafeterias/{cafeId}/products/{productId} {
      allow read, write: if approvedDevice(cafeId);
    }

    match /cafeterias/{cafeId}/sales/{saleId} {
      allow read, write: if approvedDevice(cafeId);
    }

    match /cafeterias/{cafeId}/mesas/{mesaId} {
      allow read, write: if approvedDevice(cafeId);
    }
  }
}
